---
import { SITE } from '../lib';
interface Props { title?: string; description?: string }
const { title, description = '개발하며 생각한 것들을 적습니다.' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '나' },
  { href: '/blog/', label: '게시글' },
  { href: '/notes/', label: '짧은글' },
];
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header>
      <a class="brand" href="/">{SITE.title}</a>
      <nav>
        {nav.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <a href="https://github.com/milo-joon">GitHub</a> · <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fdfdfc; --fg: #1f1f1f; --muted: #74746f; --line: #e6e6e2; --accent: #2b6cb0; --code-bg: #f4f4f2;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #161616; --fg: #e8e8e6; --muted: #9a9a95; --line: #2c2c2c; --accent: #7fb2e5; --code-bg: #202020; }
    .astro-code, .astro-code span { color: var(--shiki-dark) !important; background-color: var(--shiki-dark-bg) !important; }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0 auto; max-width: 680px; padding: 0 16px;
    background: var(--bg); color: var(--fg);
    font: 17px/1.75 -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Pretendard', 'Noto Sans KR', sans-serif;
    word-break: keep-all; overflow-wrap: break-word;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  header { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; padding: 40px 0 24px; }
  .brand { color: var(--fg); font-weight: 700; }
  nav { display: flex; gap: 16px; }
  nav a { color: var(--muted); }
  nav a[aria-current='page'] { color: var(--fg); font-weight: 600; }
  main { min-height: 60vh; }
  footer { margin: 80px 0 40px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  footer a { color: var(--muted); }
  h1 { font-size: 1.6rem; line-height: 1.4; margin: 0 0 8px; }
  h2 { font-size: 1.25rem; margin: 2.2em 0 0.6em; }
  h3 { font-size: 1.08rem; margin: 1.8em 0 0.5em; }
  .muted { color: var(--muted); font-size: 0.9rem; }
  img { max-width: 100%; height: auto; border-radius: 6px; }
  hr { border: 0; border-top: 1px solid var(--line); margin: 2em 0; }
  blockquote { margin: 1.2em 0; padding-left: 1em; border-left: 3px solid var(--line); color: var(--muted); }
  code { font-size: 0.88em; background: var(--code-bg); padding: 0.1em 0.35em; border-radius: 4px; }
  pre { padding: 14px 16px; border-radius: 8px; overflow-x: auto; font-size: 14px; line-height: 1.6; }
  pre code { background: none; padding: 0; }
  table { border-collapse: collapse; display: block; overflow-x: auto; }
  th, td { border: 1px solid var(--line); padding: 6px 10px; }
  ul.list { list-style: none; padding: 0; margin: 0; }
  ul.list li { display: flex; justify-content: space-between; gap: 16px; padding: 6px 0; }
  ul.list time { color: var(--muted); font-size: 0.9rem; white-space: nowrap; }
  @media (max-width: 480px) { ul.list li { flex-direction: column; gap: 0; } }
</style>
