---
import Base from '../layouts/Base.astro';
import { getPosts, getNotes, fmt } from '../lib';

const posts = (await getPosts()).slice(0, 5);
const notes = (await getNotes()).slice(0, 5);
const preview = (s = '') => {
  const t = s.replace(/[#>*_`\[\]()!-]/g, '').replace(/\s+/g, ' ').trim();
  return t.length > 50 ? t.slice(0, 50) + '…' : t;
};
---
<Base>
  <section>
    <p>
      안녕하세요, 개발자로 일하고 있는 이현준입니다.<br />
      생각나면 끄적이거나 정리하는 것을 좋아하고, 항상 Why를 많이 생각하려 합니다.
    </p>
    <p class="muted">
      <a href="https://github.com/milo-joon">GitHub</a> · <a href="https://www.linkedin.com/in/hjleeeee">LinkedIn</a>
    </p>
  </section>

  <h2>게시글</h2>
  <ul class="list">
    {posts.map((p) => (
      <li><a href={`/blog/${p.id}/`}>{p.data.title}</a><time>{fmt(p.data.date)}</time></li>
    ))}
  </ul>
  <p class="muted"><a href="/blog/">전체 보기 →</a></p>

  <h2>짧은글</h2>
  <ul class="list">
    {notes.map((n) => (
      <li><a href={`/notes/#${n.id}`}>{preview(n.body)}</a><time>{fmt(n.data.date)}</time></li>
    ))}
  </ul>
  <p class="muted"><a href="/notes/">전체 보기 →</a></p>
</Base>
